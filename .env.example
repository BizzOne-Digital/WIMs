# WIMs environment variables.
# Copy this file to .env.local (gitignored) and fill in the values. Never commit real secrets.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# MongoDB connection string, e.g. from MongoDB Atlas:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Optional: database name (defaults to the one in the connection string)
MONGODB_DB=wims

# Admin sign-in for /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs admin sessions. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Public site URL, used for canonical links, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://www.example.com
